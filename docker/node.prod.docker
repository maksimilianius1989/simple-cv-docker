FROM node:22-bookworm-slim

WORKDIR /app/src/simple-cv-api

ENV NODE_ENV=production

# System deps (for Puppeteer / Chromium / PDF)
RUN apt-get update && apt-get install -y \
  chromium \
  fonts-liberation \
  libnss3 \
  libxss1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libgtk-3-0 \
  ca-certificates \
  --no-install-recommends && \
  rm -rf /var/lib/apt/lists/*

# Copy package files first (for caching)
COPY src/simple-cv-api/package.json ./
COPY src/simple-cv-api/yarn.lock ./

# Install ALL deps (important for build)
RUN PUPPETEER_SKIP_DOWNLOAD=true yarn install --frozen-lockfile --production=false

# Copy source
COPY src/simple-cv-api ./

RUN yarn prisma generate

# Build app
RUN yarn build

EXPOSE 3000

COPY docker/entrypoint.sh .
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]