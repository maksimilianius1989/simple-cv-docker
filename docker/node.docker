FROM node:22-bookworm-slim

WORKDIR /app/src/simple-cv-api

# Встановлення залежностей для Chromium і pdftoppm
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    chromium \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    ca-certificates \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 3000