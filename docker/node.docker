FROM node:22-bookworm-slim

WORKDIR /app/src/api.simple-cv.life

RUN apt-get update && apt-get install -y \
  chromium \
  fonts-liberation \
  libnss3 \
  libxss1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libgtk-3-0 \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY src/api.simple-cv.life /app/src/api.simple-cv.life

RUN PUPPETEER_SKIP_DOWNLOAD=true yarn install --frozen-lockfile

EXPOSE 3000