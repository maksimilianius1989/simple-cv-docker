FROM node:22-bookworm-slim

WORKDIR /app/src/simple-cv-api

# install for the PDF generation
# install for the PDF generation
RUN apt-get update && apt-get install -y \
  chromium \
  fonts-liberation \
  libnss3 \
  libxss1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libgtk-3-0 \
  ca-certificates

EXPOSE 3000